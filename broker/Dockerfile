# =============================================================================
# Secure AIoT MQTT broker (Eclipse Mosquitto 2.x).
#
# Build-time behaviour:
#   * Copies in mosquitto.conf, passwd (placeholder), acl, and the certs/ dir
#     generated by broker/certs/generate_certs.sh.
#   * IF the build args SIM_USER_PASS / INGEST_USER_PASS are set (defaults
#     are set below for local dev convenience), runs mosquitto_passwd to
#     hash them into /mosquitto/config/passwd. For production, override the
#     build args (or better yet: mount an externally-managed passwd file).
# =============================================================================
FROM eclipse-mosquitto:2

# Default dev credentials — overridable at build time.
ARG SIM_USER=sim_user
ARG SIM_USER_PASS=sim_pass
ARG INGEST_USER=ingest_user
ARG INGEST_USER_PASS=ingest_pass

# Copy config skeleton.
COPY mosquitto.conf /mosquitto/config/mosquitto.conf
COPY passwd         /mosquitto/config/passwd
COPY acl            /mosquitto/config/acl

# Copy TLS material (pre-generated via generate_certs.sh).
COPY certs/ca.crt     /mosquitto/certs/ca.crt
COPY certs/server.crt /mosquitto/certs/server.crt
COPY certs/server.key /mosquitto/certs/server.key

# Ensure Mosquitto user can read them.
USER root
RUN chown -R mosquitto:mosquitto /mosquitto/certs /mosquitto/config \
 && chmod 600 /mosquitto/certs/server.key /mosquitto/certs/ca.key 2>/dev/null || true \
 && chmod 644 /mosquitto/certs/ca.crt /mosquitto/certs/server.crt

# Hash dev credentials into the passwd file so the stack boots for demos
# without a manual mosquitto_passwd step. Production users should either
# not set the build args and mount their own passwd, or regenerate after.
RUN if [ -n "${SIM_USER_PASS}" ]; then \
        mosquitto_passwd -c -b /mosquitto/config/passwd "${SIM_USER}" "${SIM_USER_PASS}"; \
    fi \
 && if [ -n "${INGEST_USER_PASS}" ]; then \
        mosquitto_passwd -b    /mosquitto/config/passwd "${INGEST_USER}" "${INGEST_USER_PASS}"; \
    fi

USER mosquitto

EXPOSE 8883

CMD ["/usr/sbin/mosquitto", "-c", "/mosquitto/config/mosquitto.conf"]
