# VeilSense Frontend — Environment Variables
# Copy this to .env.local for local dev, or set these in Vercel Dashboard > Settings > Environment Variables

# URL of your deployed backend (FastAPI)
# Leave empty to run in Demo Mode (uses built-in mock data)
NEXT_PUBLIC_API_URL=

# WebSocket URL of your deployed backend
# Leave empty to disable live telemetry streaming
NEXT_PUBLIC_WS_URL=
