# VeilSense Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
JWT_SECRET=veilsense_super_secret_production_key_change_in_prod_2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MQTT Settings
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=veilsense_agent
MQTT_PASSWORD=veilsense_edge_secret
MQTT_CA_CERT=../infra/certs/ca.crt
MQTT_CLIENT_CERT=../infra/certs/client.crt
MQTT_CLIENT_KEY=../infra/certs/client.key
MQTT_TOPIC_TELEMETRY=veilsense/telemetry/room1
MQTT_TOPIC_ACTUATION=veilsense/actuation/fan

# Database
DATABASE_FILE=veilsense.db
