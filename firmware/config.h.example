#ifndef CONFIG_H
#define CONFIG_H

// --- Wi-Fi Credentials ---
#define WIFI_SSID "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// --- MQTT Broker Configuration ---
#define MQTT_BROKER_HOST "192.168.1.100" // IP or hostname of your VeilSense server
#define MQTT_BROKER_PORT 8883            // TLS secured port
#define MQTT_CLIENT_ID "ESP32-NODE-01"
#define MQTT_USERNAME "veilsense_edge"
#define MQTT_PASSWORD "edge_secret_2025"

// --- MQTT Topics ---
#define MQTT_TOPIC_TELEMETRY "veilsense/telemetry/room1"
#define MQTT_TOPIC_ACTUATION "veilsense/actuation/fan"

// --- Hardware Pin Allocations ---
#define DHT_PIN 4        // Digital Pin for DHT22 Temperature & Humidity
#define DHT_TYPE DHT22
#define MQ135_PIN 34     // Analog Input Pin (ADC1_CH6) for MQ-135 Air Quality Sensor
#define PIR_PIN 27       // Digital Pin with interrupt for PIR Motion Sensor
#define RELAY_FAN_PIN 18 // Digital Output Pin controlling ventilation relay

// --- Edge Aggregation Windows ---
#define SAMPLING_PERIOD_MS 1000   // 1 Hz raw sensor sampling
#define WINDOW_DURATION_MS 30000  // 30 seconds edge window aggregation

// --- Root CA Certificate (PEM format) for TLS Broker Verification ---
const char ROOT_CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
MIIB/zCCAaSgAwIBAgIUc...
(Insert your generated infra/certs/ca.crt content here)
-----END CERTIFICATE-----
)EOF";

#endif // CONFIG_H
